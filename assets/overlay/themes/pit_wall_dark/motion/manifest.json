{
  "schemaVersion": 1,
  "themeId": "pitwall_race_control",
  "pipeline": "alpha-vp9",
  "fallback": "css",
  "webmNaming": "stem-without-extension",
  "webm": [
    "enter_reveal",
    "theme_glitch",
    "active_pulse",
    "compact_mask",
    "suspend_dim",
    "resume_reacquire",
    "result_burst",
    "exit_trace",
    "battle_signal_lock",
    "timing_projection_sweep",
    "position_chevron_hit",
    "exception_link_drop",
    "pit_stop_ring",
    "bio_pulse",
    "session_finish_burst"
  ],
  "intents": {
    "enter": {
      "reels": [
        "enter_reveal",
        "theme_glitch"
      ]
    },
    "active": {
      "reels": [
        "active_pulse"
      ]
    },
    "result": {
      "reels": [
        "result_burst"
      ]
    },
    "exit": {
      "reels": [
        "exit_trace"
      ]
    },
    "pit-phase": {
      "reels": [
        "pit_stop_ring"
      ]
    },
    "exception-alert": {
      "reels": [
        "exception_link_drop"
      ]
    },
    "session-sweep": {
      "reels": [
        "session_finish_burst"
      ]
    }
  },
  "reels": {
    "enter_reveal": {
      "file": "enter_reveal.webm",
      "durationMs": 366,
      "intent": "native plate reveal with rail and timing sweep",
      "canvas": "transient",
      "fps": 30,
      "alpha": true
    },
