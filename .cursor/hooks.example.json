{
  "version": 1,
  "hooks": {
    "beforeReadFile": [
      {
        "command": "python .cursor/hooks/block_sensitive_reads.py"
      }
    ],
    "beforeShellExecution": [
      {
        "command": "python .cursor/hooks/shell_guard.py"
      }
    ],
    "stop": [
      {
        "command": "python .cursor/hooks/dokumentace_handover.py"
      }
    ]
  }
}

