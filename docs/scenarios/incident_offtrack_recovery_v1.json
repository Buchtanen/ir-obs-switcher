        "run_epoch": 0,
        "player_car_idx": 12,
        "incidents": 0,
        "trackSurface": "ON_TRACK",
        "towTime": 0.0,
        "speed": 42.0,
        "lapDistance": 0.40
      },
      "timeline": [
        {
          "t": 0.0,
          "set": {
            "incidents": 0,
            "trackSurface": "ON_TRACK",
            "speed": 42.0,
            "lapDistance": 0.4
          }
        },
        {
          "t": 0.05,
          "set": {
            "incidents": 2,
            "trackSurface": "OFF_TRACK",
            "speed": 18.0,
            "lapDistance": 0.401
          }
        },
        {
          "t": 0.26,
          "set": {
            "trackSurface": "OFF_TRACK",
            "speed": 0.4,
            "lapDistance": 0.4011
          }
        },
        {
          "t": 7.5,
          "set": {
            "trackSurface": "ON_TRACK",
            "speed": 3.0,
            "lapDistance": 0.4013
          }
        },
        {
          "t": 8.15,
          "set": {
            "trackSurface": "ON_TRACK",
            "speed": 8.0,
            "lapDistance": 0.4024
          }
        }
      ],
      "expectTransitions": [
        "IDLE->CLASSIFYING",
        "CLASSIFYING->DISPLACED_OFF_TRACK",
        "DISPLACED_OFF_TRACK->RECOVERED"
