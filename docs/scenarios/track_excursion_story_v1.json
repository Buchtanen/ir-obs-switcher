      "facts": [
        "RESET_TO_PITS"
      ],
      "cs": "Resetuje do boxů; toto kolo končí."
    }
  ],
  "acceptanceCases": [
    {
      "id": "off_track_suppresses_generic_incident_copy",
      "given": [
        "incident_counter_rise",
        "OFF_TRACK_ENTERED"
      ],
      "mustSelectSemanticFact": "OFF_TRACK_ENTERED",
      "mustNotSelectNode": "incident",
      "mustNotContainLexeme": "incident"
    },
    {
      "id": "contact_after_excursion_is_not_assumed_cause",
      "given": [
        "OFF_TRACK_ENTERED@0.0",
        "CONTACT_PROBABLE@0.8"
      ],
      "expectTemporalRelation": "after_core",
      "mustNotClaim": "contact_caused_excursion"
    },
    {
      "id": "slow_rejoin_does_not_assert_damage",
      "given": [
        "BACK_ON_TRACK",
        "PACE_LOSS_SUSTAINED"
      ],
      "maySay": [
        "back_on_track",
        "continuing_slowly"
      ],
      "mustNotSay": [
        "damage_confirmed",
        "pit_for_repairs"
      ]
    },
    {
      "id": "race_tow_is_not_retirement",
      "mode": "RACE",
      "given": [
        "OFF_TRACK_ENTERED",
        "STOPPED",
        "TOW_ACTIVE"
      ],
      "expectOutcome": "TOW_STARTED",
      "mustNotSay": "retired"
    },
    {
      "id": "practice_reset_is_not_driven_pit_entry",
      "mode": "PRACTICE",
      "given": [
        "OFF_TRACK_ENTERED",
        "reset_teleport_signature"
      ],
      "expectOutcome": "RESET_TO_PITS",
      "forbidOutcome": "PIT_ENTRY_DRIVEN"
    },
    {
      "id": "unknown_cause_keeps_specific_core",
      "given": [
        "CAUSE_UNKNOWN",
        "OFF_TRACK_ENTERED"
      ],
      "mustSayFact": "OFF_TRACK_ENTERED",
      "mustOmit": "cause"
    },
    {
      "id": "incident_word_allowed_for_points_only",
      "givenEventType": "INCIDENT_POINTS_UPDATE",
      "givenMetrics": {
        "incidentPoints": 4
      },
      "mayContainLexeme": "incident"
    }
  ]
}
